<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="1100" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.java.FitnessCentar.Controllers.KorisnikController">

    <!-- TOP -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#0f172a;">

            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>

            <Label style="-fx-text-fill:white;                           -fx-font-size:20px;                           -fx-font-weight:bold;" text="KORISNICI - MANAGEMENT" />
        </HBox>
    </top>

    <!-- CENTER -->
    <center>

        <HBox spacing="20">

            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- LEFT: TABLE -->
            <VBox prefWidth="700" spacing="10" style="-fx-background-color:white;                          -fx-border-color:#dcdcdc;">

                <padding>
                    <Insets bottom="15" left="15" right="15" top="15" />
                </padding>

                <Label style="-fx-font-size:18px;                               -fx-font-weight:bold;" text="Popis korisnika" />

                <TextField fx:id="searchField" onKeyReleased="#search" promptText="Pretraži korisnike..." />

                <TableView fx:id="korisnikTable" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
                        <TableColumn fx:id="imeColumn" prefWidth="121.0" text="Ime" />
                        <TableColumn fx:id="passwordColumn" prefWidth="178.0" text="Password" />
                        <TableColumn fx:id="emailColumn" prefWidth="139.0" text="Email" />
                        <TableColumn fx:id="ulogaColumn" prefWidth="162.0" text="Uloga" />

                    </columns>

                </TableView>

            </VBox>

            <!-- RIGHT: FORM -->
            <VBox prefWidth="350" spacing="10" style="-fx-background-color:white;                          -fx-border-color:#dcdcdc;">

                <padding>
                    <Insets bottom="15" left="15" right="15" top="15" />
                </padding>

                <Label style="-fx-font-size:18px;                               -fx-font-weight:bold;" text="Korisnik detalji" />

                <Separator />

                <Label text="Ime" />
                <TextField fx:id="imeField" />

                <Label text="Email" />
                <TextField fx:id="emailField" />

                <Label text="Password" />
                <PasswordField fx:id="passwordField" />

                <Label text="Uloga" />
                <ComboBox fx:id="ulogaComboBox" />

                <HBox spacing="10">

                    <Button onAction="#save" style="-fx-background-color:#16a34a;                                    -fx-text-fill:white;" text="Spremi" />

                    <Button onAction="#update" style="-fx-background-color:#2563eb;                                    -fx-text-fill:white;" text="Update" />

                </HBox>

                <Button onAction="#delete" style="-fx-background-color:#dc2626;                                -fx-text-fill:white;" text="Obriši" />

            </VBox>

        </HBox>

    </center>

</BorderPane>
