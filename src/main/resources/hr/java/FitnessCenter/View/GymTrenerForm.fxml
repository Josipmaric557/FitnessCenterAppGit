<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.*?>

<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.java.FitnessCentar.Controllers.GymTrenerController"
            prefWidth="1200"
            prefHeight="750">


    <!-- TOP -->
    <top>
        <VBox>



            <HBox spacing="10"
                  alignment="CENTER_LEFT"
                  style="-fx-background-color:#0f172a;">
                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>

                <Label text="Gym - Trener Management"
                       style="-fx-text-fill:white;
                          -fx-font-size:22px;
                          -fx-font-weight:bold;"/>
            </HBox>

        </VBox>
    </top>

    <!-- CENTER -->
    <center>

        <HBox spacing="20">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- LEFT: GYM LIST -->
            <VBox prefWidth="700"
                  spacing="10"
                  style="-fx-background-color:white;
                     -fx-border-color:#dcdcdc;">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Gymovi"
                       style="-fx-font-size:18px;
                          -fx-font-weight:bold;"/>

                <TextField fx:id="searchGymField"
                           promptText="Pretraži gym..."/>

                <TableView fx:id="gymTableView"
                           VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn fx:id="gymIdColumn" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="gymNameColumn" text="Naziv" prefWidth="180"/>
                        <TableColumn fx:id="gymCityColumn" text="Grad" prefWidth="140"/>
                    </columns>

                </TableView>

            </VBox>

            <!-- RIGHT: TRENER MANAGEMENT -->
            <VBox prefWidth="450"
                  spacing="12"
                  style="-fx-background-color:white;
                     -fx-border-color:#dcdcdc;">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Treneri u gymu"
                       style="-fx-font-size:18px;
                          -fx-font-weight:bold;"/>

                <Separator/>

                <!-- ADD TRAINER -->
                <Label text="Dodaj trenera"/>

                <ComboBox fx:id="trenerComboBox"
                          promptText="Odaberi trenera"/>

                <Button text="Dodijeli treneru"
                        onAction="#assignTrener"/>

                <Separator/>

                <!-- LIST -->
                <Label text="Treneri u odabranom gymu"/>

                <ListView fx:id="trenerListView"
                          VBox.vgrow="ALWAYS"/>

                <HBox spacing="10">

                    <Button text="Ukloni trenera"
                            onAction="#removeTrener"
                            style="-fx-background-color:#dc2626;
                               -fx-text-fill:white;"/>

                </HBox>

                <Separator/>

                <!-- INFO -->
                <Label text="Info"
                       style="-fx-font-weight:bold;"/>

                <Label text="Odaberi gym, zatim dodaj ili ukloni trenera."/>

            </VBox>

        </HBox>

    </center>


</BorderPane>
