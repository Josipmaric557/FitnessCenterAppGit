<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.*?>

<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.java.FitnessCentar.Controllers.KategorijaController"
            prefWidth="1000"
            prefHeight="650">


    <!-- TOP -->
    <top>
        <VBox>

            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  style="-fx-background-color:#0f172a;">

                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>

                <Label text="KATEGORIJE - MANAGEMENT"
                       style="-fx-text-fill:white;
                          -fx-font-size:20px;
                          -fx-font-weight:bold;"/>
            </HBox>

        </VBox>
    </top>

    <!-- CENTER -->
    <center>

        <HBox spacing="20">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- LEFT: TABLE -->
            <VBox prefWidth="600"
                  spacing="10"
                  style="-fx-background-color:white;
                     -fx-border-color:#dcdcdc;">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Popis kategorija"
                       style="-fx-font-size:18px;
                          -fx-font-weight:bold;"/>

                <TextField fx:id="searchField"
                           promptText="Pretraži kategoriju..."
                           onKeyReleased="#search"/>

                <TableView fx:id="kategorijaTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>

                        <TableColumn fx:id="nazivColumn" text="Naziv" prefWidth="150"/>

                        <TableColumn fx:id="opisColumn" text="Opis" prefWidth="200"/>

                        <TableColumn fx:id="vrstaColumn" text="Vrsta gym-a" prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

            <!-- RIGHT: FORM -->
            <VBox prefWidth="350"
                  spacing="12"
                  style="-fx-background-color:white;
                     -fx-border-color:#dcdcdc;">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Kategorija detalji"
                       style="-fx-font-size:18px;
                          -fx-font-weight:bold;"/>

                <Separator/>

                <Label text="Naziv"/>
                <TextField fx:id="nazivField"
                           promptText="Unesi naziv kategorije"/>

                <Label text="Opis"/>
                <TextField fx:id="opisField"
                           promptText="Unesi opis kategorije"/>

                <Label text="Vrsta gym-a"/>

                <ComboBox fx:id="vrstaComboBox"
                          prefWidth="300"
                          promptText="Odaberi vrstu gym-a"/>

                <HBox spacing="10">

                    <Button text="Spremi"
                            onAction="#save"
                            style="-fx-background-color:#16a34a;
                               -fx-text-fill:white;"/>

                    <Button text="Update"
                            onAction="#update"
                            style="-fx-background-color:#2563eb;
                               -fx-text-fill:white;"/>

                </HBox>

                <Button text="Obriši"
                        onAction="#delete"
                        style="-fx-background-color:#dc2626;
                           -fx-text-fill:white;"/>



                <Label text="Info:"
                       style="-fx-font-weight:bold;"/>

                <Label text="Kategorije se koriste za povezivanje Gym-a."/>

            </VBox>

        </HBox>

    </center>


</BorderPane>
