<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="850" prefWidth="1500" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.java.FitnessCentar.Controllers.GymController">

    <!-- ================= TOP ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#0f172a;">

            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>

            <Label style="-fx-text-fill:white;                           -fx-font-size:22px;                           -fx-font-weight:bold;" text="GYM MANAGEMENT SYSTEM" />
        </HBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>

        <HBox spacing="15">

            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>

            <!-- ===================================================== -->
            <!-- LEFT SIDE - TABLE -->
            <!-- ===================================================== -->

            <VBox prefWidth="500" spacing="10" style="-fx-background-color:white;                          -fx-border-color:#d1d5db;                          -fx-border-radius:8;                          -fx-background-radius:8;">

                <padding>
                    <Insets bottom="15" left="15" right="15" top="15" />
                </padding>

                <Label style="-fx-font-size:20px;                               -fx-font-weight:bold;" text="Gymovi" />

                <TextField fx:id="searchField" promptText="Search gym..." />

                <TableView fx:id="gymTableView" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />

                        <TableColumn fx:id="nazivColumn" prefWidth="170" text="Naziv" />

                        <TableColumn fx:id="gradColumn" prefWidth="120" text="Grad" />

                        <TableColumn fx:id="adresaColumn" prefWidth="220" text="Adresa" />

                    </columns>

                </TableView>

            </VBox>

            <!-- ===================================================== -->
            <!-- CENTER - CRUD -->
            <!-- ===================================================== -->

            <VBox prefWidth="450" spacing="10" style="-fx-background-color:white;                          -fx-border-color:#d1d5db;                          -fx-border-radius:8;                          -fx-background-radius:8;">

                <padding>
                    <Insets bottom="15" left="15" right="15" top="15" />
                </padding>

                <Label style="-fx-font-size:20px;                               -fx-font-weight:bold;" text="CRUD Gym" />

                <Label fx:id="selectedGymLabel" style="-fx-font-size:15px;                               -fx-text-fill:#374151;" text="-- none selected --" />

                <Separator />

                <GridPane hgap="10" vgap="10">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="30" />
                        <ColumnConstraints percentWidth="70" />
                    </columnConstraints>

                    <!-- Naziv -->
                    <Label text="Naziv:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                    <TextField fx:id="nazivField" promptText="Naziv gyma" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <!-- Adresa -->
                    <Label text="Adresa:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <TextField fx:id="adresaField" promptText="Adresa" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <!-- Grad -->
                    <Label text="Grad:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                    <TextField fx:id="gradField" promptText="Grad" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <!-- Radno vrijeme -->
                    <Label text="Radno vrijeme:" GridPane.columnIndex="0" GridPane.rowIndex="3" />

                    <TextField fx:id="radnoVrijemeField" promptText="08:00 - 22:00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <!-- Cijena -->
                    <Label text="Članarina:" GridPane.columnIndex="0" GridPane.rowIndex="4" />

                    <TextField fx:id="cijenaField" promptText="Cijena" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <!-- Povrsina -->
                    <Label text="Površina:" GridPane.columnIndex="0" GridPane.rowIndex="5" />

                    <TextField fx:id="povrsinaField" promptText="Površina" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <!-- Foto -->
                    <Label text="Foto:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <Button onAction="#uploadImage" GridPane.columnIndex="1" GridPane.rowIndex="6">Upload Image</Button>

               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>

                <Separator />

                <!-- BUTTONS -->
                <HBox spacing="10">

                    <Button onAction="#createGym" prefWidth="100" style="-fx-background-color:#16a34a;                                    -fx-text-fill:white;                                    -fx-font-weight:bold;" text="Create" />

                    <Button onAction="#updateGym" prefWidth="100" style="-fx-background-color:#2563eb;                                    -fx-text-fill:white;                                    -fx-font-weight:bold;" text="Update" />

                    <Button onAction="#deleteGym" prefWidth="100" style="-fx-background-color:#dc2626;                                    -fx-text-fill:white;                                    -fx-font-weight:bold;" text="Delete" />

                    <Button  prefWidth="100" style="-fx-background-color:#6b7280;                                    -fx-text-fill:black;                                    -fx-font-weight:bold;" text="Xml Export" />


                </HBox>
            <ImageView fx:id="imageGymView" fitHeight="254.0" fitWidth="419.0" pickOnBounds="true" preserveRatio="true" />

            </VBox>

            <!-- ===================================================== -->
            <!-- RIGHT SIDE - RELATIONS -->
            <!-- ===================================================== -->

            <VBox prefWidth="450" spacing="12" style="-fx-background-color:white;                          -fx-border-color:#d1d5db;                          -fx-border-radius:8;                          -fx-background-radius:8;">

                <padding>
                    <Insets bottom="15" left="15" right="15" top="15" />
                </padding>

                <Label style="-fx-font-size:20px;                               -fx-font-weight:bold;" text="Zavisnosti Gyma" />

                <Label style="-fx-text-fill:#6b7280;" text="Ovdje možeš vidjeti što pripada odabranom gymu." />

                <Separator />

                <!-- KATEGORIJE -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">

                    <Label style="-fx-font-weight:bold;" text="Kategorije" />

                    <ListView fx:id="kategorijaListView" prefHeight="120" />
                </VBox>

                <!-- TRENERI -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">

                    <Label style="-fx-font-weight:bold;" text="Treneri" />

                    <ListView fx:id="trenerListView" prefHeight="120" />
                </VBox>

                <!-- PROGRAMI -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">

                    <Label style="-fx-font-weight:bold;" text="Programi" />

                    <ListView fx:id="programListView" prefHeight="120" />
                </VBox>

                <!-- OPREMA -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">

                    <Label style="-fx-font-weight:bold;" text="Oprema" />

                    <ListView fx:id="opremaListView" prefHeight="120" />
                </VBox>

            </VBox>

        </HBox>

    </center>

</BorderPane>
